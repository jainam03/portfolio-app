# ── Dependencies ──────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Next.js Build Output ───────────────────────────
/.next/
/out/
/build

# ── Testing ────────────────────────────────────────
/coverage

# ── Environment Variables ──────────────────────────
# NEVER commit secrets or API keys
.env
.env*.local

# ── Dev Tools & Scripts ────────────────────────────
# Local-only utilities — not needed for Vercel deployment
/scripts

# ── Editor & OS Files ──────────────────────────────
.DS_Store
*.pem
.gemini/

# ── Debug Logs ─────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vercel ─────────────────────────────────────────
.vercel

# ── TypeScript ─────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── NOTE: public/resume.pdf is intentionally tracked ──
# Vercel serves files from /public directly.
# Excluding it would break the "Download Resume" button on the live site.

# Project presentations are stored in private Supabase Storage.
/public/projects/**/*.pdf
